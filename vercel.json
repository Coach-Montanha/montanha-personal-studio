{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/materiais",
      "permanent": true
    },
    {
      "source": "/artigos",
      "destination": "/materiais",
      "permanent": true
    },
    {
      "source": "/ebooks",
      "destination": "/materiais",
      "permanent": true
    },
    {
      "source": "/hibrido",
      "destination": "/materiais/treinamento-hibrido",
      "permanent": true
    },
    {
      "source": "/mobilidade",
      "destination": "/materiais/mobilidade",
      "permanent": true
    },
    {
      "source": "/hibrido-pdf",
      "destination": "/materiais/treinamento-hibrido/Protocolo_Atleta_Hibrido_30_Dias_Coach_Montanha.pdf",
      "permanent": true
    },
    {
      "source": "/mobilidade-pdf",
      "destination": "/materiais/mobilidade/Programa_Mobilidade_30_Dias_Coach_Montanha_Clean.pdf",
      "permanent": true
    },
    {
      "source": "/posts",
      "destination": "/materiais#artigosSection",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/pre-class",
      "schedule": "0 10 * * *"
    }
  ]
}